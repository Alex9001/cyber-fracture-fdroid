#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ ! -f "$repo_root/fdroid/config.yml" ]; then
    echo "config.yml is private and required to sign the repository index." >&2
    exit 1
fi

exec docker run --rm -v "$repo_root:/repo" -w /repo/fdroid \
    registry.gitlab.com/fdroid/docker-executable-fdroidserver:master \
    update --clean --rename-apks
